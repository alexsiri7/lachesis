# MCP server public URL (no trailing slash)
MCP_BASE_URL=https://lachesis.interstellarai.net

# GitHub Personal Access Token — used server-side for all GitHub API calls.
# Scopes: repo, and delete_repo so a failed create_project can remove its repository.
# A fine-grained token also needs Checks (read), without which a private repository's
# scenario results cannot be read, and Administration (read and write), without which a
# repository's settings, branch protection and rulesets cannot be configured for
# unattended merges.
GITHUB_PAT=ghp_...

# OAuth / JWT
SECRET_KEY=changeme
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allowlisted Google account (single-user — set to the owner's Google email)
ALLOWED_EMAIL=

# Supabase Postgres (direct connection — namespaced lachesis_ tables)
DATABASE_URL=postgresql://postgres:[password]@db.<project-ref>.supabase.co:5432/postgres

# Model routing — Claude's blended price per million tokens, the reference overflow models
# must beat to be routed to while the Claude allowance lasts
CLAUDE_USD_PER_MILLION_TOKENS=5.0

# Sprints — the weekly Claude allowance expressed in tokens, the size the sprint budget's
# allowance share is taken from; tune it to what a week actually allows
CLAUDE_WEEKLY_ALLOWANCE_TOKENS=100000000

# Sprints — the percent of the sprint budget kept for the work of improvement experiments,
# planned ahead of the ordinary backlog
IMPROVEMENT_SHARE_PERCENT=10

# Sprints — the percent of the sprint budget kept for trials, runs by models not yet trusted
# for the kind and size they run
TRIAL_SHARE_PERCENT=10

# Sentry (optional)
SENTRY_DSN=

# MCP host security
MCP_ALLOWED_HOSTS=lachesis.interstellarai.net
